<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Request localization, supported cultures and translated error descriptions.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\SharedKernel\MicroServiceSystem.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Culture-suffixed names (errors.tr-TR.json) would otherwise become
         satellite *.resources.dll and vanish from GetManifestResourceStream. -->
    <EmbeddedResource Include="Resources\Errors\errors.*.json">
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
  </ItemGroup>

</Project>
