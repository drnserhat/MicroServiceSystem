{
  "ServiceDefaults": {
    "ServiceName": "gateway",
    "ServiceDescription": "API gateway",
    "EnableSwagger": false,
    "EnableRateLimiting": true
  },
  "MultiTenancy": {
    "Enabled": true,
    "RequireTenant": false,
    "TrustTenantHeader": true
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "msf",
      "Audience": "msf",
      "SigningKey": "0123456789abcdef0123456789abcdef01234567",
      "AccessTokenLifetimeMinutes": 15,
      "RefreshTokenLifetimeDays": 14,
      "RequireHttpsMetadata": false
    }
  },
  "Cache": {
    "Provider": "Memory",
    "InstanceName": "gateway"
  },
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity",
        "Match": { "Path": "/identity/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/identity" }]
      },
      "user-route": {
        "ClusterId": "user",
        "Match": { "Path": "/user/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/user" }]
      },
      "coordinator-route": {
        "ClusterId": "coordinator",
        "Match": { "Path": "/coordinator/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/coordinator" }]
      },
      "registration-route": {
        "ClusterId": "coordinator",
        "Match": { "Path": "/registration/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/v1/registration/{**catch-all}" }
        ]
      },
      "notification-route": {
        "ClusterId": "notification",
        "Match": { "Path": "/notification/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/notification" }]
      },
      "file-route": {
        "ClusterId": "file",
        "Match": { "Path": "/file/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/file" }]
      },
      "audit-route": {
        "ClusterId": "audit",
        "Match": { "Path": "/audit/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/audit" }]
      },
      "settings-route": {
        "ClusterId": "settings",
        "Match": { "Path": "/settings/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/settings" }]
      },
      "location-route": {
        "ClusterId": "location",
        "Match": { "Path": "/location/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/location" }]
      },
      "logging-route": {
        "ClusterId": "logging",
        "Match": { "Path": "/logging/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/logging" }]
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": { "d1": { "Address": "http://localhost:5080/" } }
      },
      "user": {
        "Destinations": { "d1": { "Address": "http://localhost:5081/" } }
      },
      "coordinator": {
        "Destinations": { "d1": { "Address": "http://localhost:5082/" } }
      },
      "notification": {
        "Destinations": { "d1": { "Address": "http://localhost:5083/" } }
      },
      "file": {
        "Destinations": { "d1": { "Address": "http://localhost:5084/" } }
      },
      "audit": {
        "Destinations": { "d1": { "Address": "http://localhost:5085/" } }
      },
      "settings": {
        "Destinations": { "d1": { "Address": "http://localhost:5086/" } }
      },
      "location": {
        "Destinations": { "d1": { "Address": "http://localhost:5087/" } }
      },
      "logging": {
        "Destinations": { "d1": { "Address": "http://localhost:5088/" } }
      }
    }
  },
  "Telemetry": {
    "ServiceName": "gateway"
  },
  "Logging": {
    "Framework": {
      "MinimumLevel": "Information",
      "WriteToConsole": true
    }
  },
  "AllowedHosts": "*"
}
