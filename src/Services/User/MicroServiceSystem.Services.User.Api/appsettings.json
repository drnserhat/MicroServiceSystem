{
  "ServiceDefaults": {
    "ServiceName": "user",
    "ServiceDescription": "User profile service",
    "EnableSwagger": false,
    "EnableRateLimiting": true
  },
  "MultiTenancy": {
    "Enabled": true,
    "RequireTenant": true,
    "TrustTenantHeader": false
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "msf",
      "Audience": "msf",
      "SigningKey": "",
      "AccessTokenLifetimeMinutes": 15,
      "RefreshTokenLifetimeDays": 14,
      "RequireHttpsMetadata": true
    },
    "InternalService": {
      "Enabled": false,
      "ApiKey": ""
    }
  },
  "Persistence": {
    "Postgres": {
      "ConnectionString": "",
      "Schema": "user",
      "ApplyMigrationsOnStartup": false
    }
  },
  "Cache": {
    "Provider": "Memory",
    "InstanceName": "user"
  },
  "Messaging": {
    "RabbitMq": {
      "Host": "",
      "UserName": "",
      "Password": ""
    },
    "Outbox": { "Enabled": true },
    "Inbox": { "Enabled": true }
  },
  "Telemetry": {
    "ServiceName": "user"
  },
  "Logging": {
    "Framework": {
      "MinimumLevel": "Information",
      "WriteToConsole": true
    }
  },
  "AllowedHosts": "*"
}
