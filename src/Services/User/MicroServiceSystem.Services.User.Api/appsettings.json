{
  "ServiceDefaults": {
    "ServiceName": "user",
    "ServiceDescription": "User profile service",
    "EnableSwagger": true,
    "EnableRateLimiting": true
  },
  "MultiTenancy": {
    "Enabled": true,
    "RequireTenant": false,
    "TrustTenantHeader": true
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "msf",
      "Audience": "msf",
      "SigningKey": "0123456789abcdef0123456789abcdef01234567",
      "AccessTokenLifetimeMinutes": 15,
      "RefreshTokenLifetimeDays": 14,
      "RequireHttpsMetadata": false
    },
    "InternalService": {
      "Enabled": true,
      "ApiKey": "dev-internal-api-key-change-me"
    }
  },
  "Persistence": {
    "Postgres": {
      "ConnectionString": "Host=localhost;Port=5432;Database=user;Username=msf;Password=msf",
      "Schema": "user",
      "ApplyMigrationsOnStartup": true
    }
  },
  "Cache": {
    "Provider": "Memory",
    "InstanceName": "user"
  },
  "Messaging": {
    "RabbitMq": {
      "Host": "localhost",
      "UserName": "msf",
      "Password": "msf"
    },
    "Outbox": { "Enabled": true },
    "Inbox": { "Enabled": true }
  },
  "Telemetry": {
    "ServiceName": "user"
  },
  "Logging": {
    "Framework": {
      "MinimumLevel": "Information",
      "WriteToConsole": true
    }
  },
  "AllowedHosts": "*"
}
