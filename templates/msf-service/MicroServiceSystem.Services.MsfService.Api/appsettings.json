{
  "ServiceDefaults": {
    "ServiceName": "msfservice",
    "ServiceDescription": "MsfService service",
    "EnableSwagger": true,
    "EnableRateLimiting": true,
    "RateLimiting": {
      "PermitLimit": 100,
      "WindowSeconds": 60
    }
  },
  "MultiTenancy": {
    "Enabled": true,
    "RequireTenant": true,
    "TrustTenantHeader": false
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "",
      "Audience": "",
      "SigningKey": "",
      "AccessTokenLifetimeMinutes": 15,
      "RefreshTokenLifetimeDays": 14
    }
  },
  "Persistence": {
    "Postgres": {
      "ConnectionString": "",
      "Schema": "msfservice",
      "ApplyMigrationsOnStartup": false
    }
  },
  "Cache": {
    "Provider": "Hybrid",
    "ConnectionString": "",
    "InstanceName": "msfservice"
  },
  "Messaging": {
    "RabbitMq": {
      "Host": "",
      "UserName": "",
      "Password": ""
    },
    "Outbox": {
      "Enabled": true
    },
    "Inbox": {
      "Enabled": true
    }
  },
  "Telemetry": {
    "ServiceName": "msfservice",
    "OtlpEndpoint": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Framework": {
      "MinimumLevel": "Information",
      "WriteToConsole": true,
      "SeqServerUrl": ""
    }
  },
  "AllowedHosts": "*"
}
