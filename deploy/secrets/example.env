# Copy to deploy/secrets/.env (gitignored) or export into the environment before starting apps /
# running deploy/migrate/migrate-all.sh. ASP.NET Core maps double-underscore env vars onto
# configuration keys (Persistence__Postgres__ConnectionString → Persistence:Postgres:ConnectionString).
#
# Never commit real production values. Non-Development hosts reject the known Development placeholders.

# --- Postgres (per service database; host is the compose service name inside the network) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=msf
POSTGRES_PASSWORD=change-me

IDENTITY_CONNECTION_STRING=Host=postgres;Port=5432;Database=identity;Username=msf;Password=change-me
USER_CONNECTION_STRING=Host=postgres;Port=5432;Database=user;Username=msf;Password=change-me
POSTGRES_ADMIN_CONNECTION=Host=postgres;Port=5432;Database=postgres;Username=msf;Password=change-me
POSTGRES_APP_PASSWORD=change-me
BRANCH_DATABASE_DEFAULT_HOST=postgres
IDENTITY_SERVICE_BASE_URL=http://identity:8080/
USER_SERVICE_BASE_URL=http://user:8080/
COORDINATOR_CONNECTION_STRING=Host=postgres;Port=5432;Database=coordinator;Username=msf;Password=change-me
AUDIT_CONNECTION_STRING=Host=postgres;Port=5432;Database=audit;Username=msf;Password=change-me
FILE_CONNECTION_STRING=Host=postgres;Port=5432;Database=file;Username=msf;Password=change-me
LOCATION_CONNECTION_STRING=Host=postgres;Port=5432;Database=location;Username=msf;Password=change-me
NOTIFICATION_CONNECTION_STRING=Host=postgres;Port=5432;Database=notification;Username=msf;Password=change-me
SETTINGS_CONNECTION_STRING=Host=postgres;Port=5432;Database=settings;Username=msf;Password=change-me

# --- Shared infrastructure ---
REDIS_CONNECTION=redis:6379
RABBITMQ_HOST=rabbitmq
RABBITMQ_USERNAME=msf
RABBITMQ_PASSWORD=change-me
MONGO_CONNECTION_STRING=mongodb://mongodb:27017

# --- Auth (must not equal KnownInsecureSecrets Development placeholders outside Development) ---
JWT_SIGNING_KEY=replace-with-at-least-32-random-bytes-base64-or-hex
JWT_ISSUER=msf
JWT_AUDIENCE=msf
INTERNAL_API_KEY=replace-with-a-long-random-internal-api-key
